rules_version = '2';
// ============================================================
//  Reglas de Firestore - Menu LANS
//  - Todo requiere token (Firebase Auth anonimo). Sin token = nada.
//  - PINs en config/secrets, ilegibles desde el cliente:
//      adminPin -> nivel "admin": comedor, editar menu y ver pedidos
//      superPin -> nivel "super": RRHH, todo (cortesias, reportes, limpiar, catalogo, RFC)
//  - El admin "inicia sesion" creando admin_sessions/{uid} con el PIN;
//    las reglas comparan el PIN contra config/secrets y guardan el nivel. Expira a las 12 h.
//  - Regla unica de pedidos (acordada con Talento Humano 2026-09-25):
//      se puede pedir y cancelar a cualquier hora y cualquier dia,
//      SIEMPRE para el dia siguiente en adelante. El dia de hoy nunca se agrega
//      ni se quita de un pedido (salvo super). Hora de Mexico (UTC-6).
//  - Empleados solo pueden leer SU pedido (get); listar todos requiere admin.
//  - RFCs viven en config/catalogo_rfc, solo super.
//  - comentarios/{id}: buzon anonimo. Cualquiera crea; admin/super leen; solo super borra.
// ============================================================
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function secrets() {
      return get(/databases/$(db)/documents/config/secrets).data;
    }

    function sessionPath() {
      return /databases/$(db)/documents/admin_sessions/$(request.auth.uid);
    }

    function hasSession() {
      return signedIn()
        && exists(sessionPath())
        && get(sessionPath()).data.createdAt > request.time - duration.value(12, 'h');
    }

    function level() {
      return get(sessionPath()).data.level;
    }

    function isAdmin() {
      return hasSession() && level() in ['admin', 'super'];
    }

    function isSuper() {
      return hasSession() && level() == 'super';
    }

    // --- Dia de la semana en hora local de Mexico (UTC-6, sin horario de verano) ---
    // 1 = lunes ... 7 = domingo
    function mxDow() {
      return request.time.hours() < 6
        ? (request.time.dayOfWeek() == 1 ? 7 : request.time.dayOfWeek() - 1)
        : request.time.dayOfWeek();
    }
    function hoyNombre() {
      return ['Lunes', 'Martes', 'Miercoles', 'Jueves', 'Viernes', 'Sabado', 'Domingo'][mxDow() - 1];
    }

    function catalogo() {
      return get(/databases/$(db)/documents/config/catalogo).data;
    }

    // El menu publicado es de una semana futura (se esta pidiendo la semana siguiente):
    // entonces ningun dia del menu es "hoy".
    function menuEsFuturo() {
      let m = get(/databases/$(db)/documents/config/menu).data;
      return 'mesNum' in m && m.dias.size() > 0
        && timestamp.date(m.anio, m.mesNum, m.dias[0].fecha) > request.time;
    }
    // "Un dia antes": el dia de hoy no se agrega ni se cambia
    function noTocaHoy() {
      let h = hoyNombre();
      let nuevo = request.resource.data.detalle;
      return menuEsFuturo()
        || !(h in nuevo)
        || (resource != null && h in resource.data.detalle && nuevo[h] == resource.data.detalle[h]);
    }
    // Al borrar el pedido completo, no puede incluir el dia de hoy
    function noQuitaHoy() {
      return menuEsFuturo() || !(hoyNombre() in resource.data.detalle);
    }

    function validOrder(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['nombre', 'numEmpleado', 'fecha', 'total', 'detalle', 'opciones'])
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 120
        && d.numEmpleado is string && d.numEmpleado.size() > 0 && d.numEmpleado.size() <= 20
        && d.fecha is string && d.fecha.size() <= 40
        && d.total is int && d.total >= 0 && d.total <= 7
        && d.detalle is map && d.detalle.size() <= 7
        && (!('opciones' in d) || (d.opciones is map && d.opciones.size() <= 7))
        && id in catalogo();
    }

    function validComentario() {
      let d = request.resource.data;
      return d.keys().hasOnly(['texto', 'fecha', 'foto'])
        && d.texto is string && d.texto.size() >= 3 && d.texto.size() <= 400
        && d.fecha is string && d.fecha.size() <= 40
        && (!('foto' in d) || (d.foto is string && d.foto.size() <= 250000));
    }

    // --- Secretos: nadie los lee ni escribe desde el cliente ---
    match /config/secrets {
      allow read, write: if false;
    }

    // --- Configuracion ---
    match /config/{doc} {
      allow read: if (signedIn() && doc in ['menu', 'catalogo'])
        || (isAdmin() && doc == 'cortesias')
        || (isSuper() && doc == 'catalogo_rfc');
      allow write: if (doc == 'menu' && isAdmin())
        || (doc in ['cortesias', 'catalogo', 'catalogo_rfc'] && isSuper());
    }

    // --- Historial por quincena (solo reportes) ---
    match /historial/{quincena} {
      allow read, write: if isSuper();
    }

    // --- Sesiones de admin (una por navegador/uid) ---
    match /admin_sessions/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pin', 'level', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && (
          (request.resource.data.level == 'super' && request.resource.data.pin == secrets().superPin)
          || (request.resource.data.level == 'admin' && request.resource.data.pin == secrets().adminPin)
        );
    }

    // --- Pedidos: un documento por numero de empleado ---
    match /orders/{id} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if isSuper() || (signedIn() && validOrder(id) && noTocaHoy());
      allow update: if isSuper() || (signedIn() && validOrder(id) && noTocaHoy());
      allow delete: if isSuper() || (signedIn() && noQuitaHoy());
    }

    // --- Buzon anonimo ---
    match /comentarios/{id} {
      allow read: if isAdmin();
      allow create: if signedIn() && validComentario();
      allow update: if false;
      allow delete: if isSuper();
    }

    // Todo lo demas: bloqueado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
