rules_version = '2';
// ============================================================
//  Reglas de Firestore - Menu LANS
//  - Todo requiere token (Firebase Auth anonimo). Sin token = nada.
//  - Los PINs viven en config/secrets y NUNCA se pueden leer desde el cliente:
//      comedorPin -> nivel "comedor": editar menu y ver pedidos
//      adminPin   -> nivel "admin":   todo menos catalogo (RRHH)
//      superPin   -> nivel "super":   todo, incluido catalogo
//  - El admin "inicia sesion" creando admin_sessions/{uid} con el PIN;
//    las reglas comparan el PIN contra config/secrets y guardan el nivel.
//  - Las sesiones expiran a las 12 h.
//  - comentarios/{id}: buzon anonimo. Cualquiera con token crea y lee; solo admin borra.
// ============================================================
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function secrets() {
      return get(/databases/$(db)/documents/config/secrets).data;
    }

    function sessionPath() {
      return /databases/$(db)/documents/admin_sessions/$(request.auth.uid);
    }

    function hasSession() {
      return signedIn()
        && exists(sessionPath())
        && get(sessionPath()).data.createdAt > request.time - duration.value(12, 'h');
    }

    function level() {
      return get(sessionPath()).data.level;
    }

    function isComedor() {
      return hasSession() && level() in ['comedor', 'admin', 'super'];
    }

    function isAdmin() {
      return hasSession() && level() in ['admin', 'super'];
    }

    function isSuper() {
      return hasSession() && level() == 'super';
    }

    function catalogo() {
      return get(/databases/$(db)/documents/config/catalogo).data;
    }

    function validOrder(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['nombre', 'numEmpleado', 'fecha', 'total', 'detalle', 'opciones'])
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 120
        && d.numEmpleado is string && d.numEmpleado.size() > 0 && d.numEmpleado.size() <= 20
        && d.fecha is string && d.fecha.size() <= 40
        && d.total is int && d.total >= 0 && d.total <= 7
        && d.detalle is map && d.detalle.size() <= 7
        && (!('opciones' in d) || (d.opciones is map && d.opciones.size() <= 7))
        && id in catalogo();
    }

    function validComentario() {
      let d = request.resource.data;
      return d.keys().hasOnly(['texto', 'fecha'])
        && d.texto is string && d.texto.size() >= 3 && d.texto.size() <= 400
        && d.fecha is string && d.fecha.size() <= 40;
    }

    // --- Secretos: nadie los lee ni escribe desde el cliente ---
    match /config/secrets {
      allow read, write: if false;
    }

    // --- Configuracion ---
    match /config/{doc} {
      allow read: if signedIn() && doc != 'secrets';
      allow write: if doc != 'secrets' && (
        (doc == 'catalogo' && isSuper())
        || (doc == 'menu' && isComedor())
        || (doc != 'catalogo' && doc != 'menu' && isAdmin())
      );
    }

    // --- Historial por quincena ---
    match /historial/{quincena} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // --- Sesiones de admin (una por navegador/uid) ---
    match /admin_sessions/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pin', 'level', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && (
          (request.resource.data.level == 'super' && request.resource.data.pin == secrets().superPin)
          || (request.resource.data.level == 'admin' && request.resource.data.pin == secrets().adminPin)
          || (request.resource.data.level == 'comedor' && 'comedorPin' in secrets() && request.resource.data.pin == secrets().comedorPin)
        );
    }

    // --- Pedidos: un documento por numero de empleado ---
    match /orders/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || (signedIn() && validOrder(id));
      allow delete: if signedIn();
    }

    // --- Buzon anonimo ---
    match /comentarios/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && validComentario();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Todo lo demas: bloqueado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
